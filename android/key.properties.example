# This file contains credentials for signing your Android app.
# **DO NOT** commit your actual passwords to version control.
#
# 1. Copy this file to `android/key.properties`. This new file is already in .gitignore.
# 2. Replace the placeholder values below with your actual keystore credentials.
#
# To generate a new keystore:
#   keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# Store the generated `upload-keystore.jks` file securely. Do not commit it to your repository.

storePassword=YOUR_STORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=upload
storeFile=upload-keystore.jks
