// This file contains secrets for the iOS app.
// **DO NOT** commit your actual API keys to version control.
//
// 1. Copy this file to `Secrets.xcconfig`. This new file is already in .gitignore.
// 2. Replace the placeholder value below with your actual Google Places API key.
// 3. Ensure your key is restricted to your app's bundle ID in the Google Cloud Console.

GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_API_KEY
