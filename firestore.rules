rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // USERS COLLECTION
    // ============================================
    // Users can read/write their own document
    // Users can query by inviteCode (for pairing)
    // Users can read other users' basic info (for pairing)
    match /users/{userId} {
      // Allow users to read their own document
      allow get: if request.auth != null && request.auth.uid == userId;
      
      // Allow users to create their own document (during registration)
      allow create: if request.auth != null && 
                       request.auth.uid == userId &&
                       // Ensure user sets their own UID correctly
                       request.resource.data.uid == userId;
      
      // Allow users to update their own document
      allow update: if request.auth != null && 
                       request.auth.uid == userId &&
                       // Prevent changing UID
                       request.resource.data.uid == userId;
      
      // Allow authenticated users to read other users' documents (needed for pairing)
      // This allows users to find their partner by invite code
      // Note: This also allows list queries which are needed for inviteCode search
      allow read: if request.auth != null;
      
      // Allow users to update other users' coupleId field (for pairing)
      // This is needed when user A pairs with user B - user A needs to update user B's coupleId
      // Security: Only allow updating coupleId field, not other fields
      allow update: if request.auth != null &&
                       // Only allow updating coupleId field
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coupleId']) &&
                       // Ensure UID doesn't change
                       request.resource.data.uid == resource.data.uid;
    }
    
    // ============================================
    // COUPLES COLLECTION
    // ============================================
    // Users can read/write couple documents where they are a member
    match /couples/{coupleId} {
      // Helper function to check if user is a member of this couple
      function isMember() {
        return request.auth != null && 
               request.auth.uid in resource.data.members;
      }
      
      // Helper function to check if user will be a member after write
      function willBeMember() {
        return request.auth != null && 
               request.auth.uid in request.resource.data.members;
      }
      
      // Allow reading if user is a member
      allow read: if isMember();
      
      // Allow creating couple if user is in the members array
      // Only allow pairs of exactly 2 users
      allow create: if willBeMember() && 
                       request.resource.data.members.size() == 2;
      
      // Allow updating if user is a member
      // Users can update their own status within the couple document
      allow update: if isMember() && willBeMember();
      
      // Don't allow deletion (couples should persist)
      allow delete: if false;
      
      // ============================================
      // MEMORIES SUBCOLLECTION
      // ============================================
      // Members of a couple can create, read, update memories
      // Only the author can update/delete their own memories
      match /memories/{memoryId} {
        // Helper function to check if user is authenticated
        function isAuthenticated() {
          return request.auth != null;
        }
        
        // Helper function to check if couple document exists
        function coupleExists() {
          return exists(/databases/$(database)/documents/couples/$(coupleId));
        }
        
        // Helper function to check if user is a member of the couple
        // Check if couple exists first to avoid errors, then check membership
        function isCoupleMember() {
          return isAuthenticated() && 
                 coupleExists() &&
                 request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
        }
        
        // Helper function to check if user is the author of the memory
        // Only works for existing documents (update/delete operations)
        function isAuthor() {
          return isAuthenticated() && 
                 resource != null &&
                 resource.data.authorId == request.auth.uid;
        }
        
        // Allow reading (list and get) if user is authenticated and couple member
        // This allows both list() queries and get() operations
        // Explicitly allow both list and get for better clarity
        allow list, get: if isCoupleMember();
        
        // Allow creating if user is a couple member and sets themselves as author
        // Also validate that pairId matches the coupleId in the path
        allow create: if isCoupleMember() && 
                        request.resource.data.authorId == request.auth.uid &&
                        request.resource.data.pairId == coupleId;
        
        // Allow updating if user is a couple member
        // For now, allow any couple member to update (can be restricted later)
        allow update: if isCoupleMember();
        
        // Allow deletion if user is a couple member and is the author
        allow delete: if isCoupleMember() && isAuthor();
      }
    }
    
    // ============================================
    // WAITLIST COLLECTION
    // ============================================
    // Public write access for waitlist signups (no auth required)
    // Allow read only for checking if email already exists (single document get)
    // List queries are not allowed (privacy)
    match /waitlist/{emailId} {
      // Allow anyone to create a waitlist entry
      // Only validate that email field exists and is a string
      // Note: Email validation and case normalization is handled in client code
      allow create: if request.resource.data.email is string &&
                       request.resource.data.email == emailId;
      
      // Allow reading single document to check if email already exists
      // This allows get() but not list() queries
      allow get: if true;
      
      // Don't allow list queries (privacy - prevents listing all emails)
      allow list: if false;
      
      // Don't allow updates or deletes from client
      allow update, delete: if false;
    }
    
    // ============================================
    // DEFAULT DENY
    // ============================================
    // Deny all other operations by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
