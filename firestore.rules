rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // USERS
    // ============================================
    match /users/{userId} {
      allow read: if request.auth != null;
      
      // Povolit zápis, pokud:
      // 1. Jsem vlastník účtu (klasika)
      // 2. NEBO pokud měním jen pole 'coupleId' (to je ten hack pro párování)
      allow write: if request.auth.uid == userId 
                   || (request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['coupleId']));
    }
    
    // ============================================
    // COUPLES
    // ============================================
    match /couples/{coupleId} {
      // Pomocné funkce
      function isMember() {
        return request.auth != null && 
               resource.data.members != null &&
               request.auth.uid in resource.data.members;
      }
      function willBeMember() {
        return request.auth != null && 
               request.resource.data.members != null &&
               request.auth.uid in request.resource.data.members;
      }
      
      // Číst mohou jen členové páru
      allow read: if isMember();
      
      // Vytvořit lze jen pár o 2 lidech, kde jsem členem
      allow create: if request.auth != null &&
                       request.resource.data.members != null &&
                       request.auth.uid in request.resource.data.members &&
                       request.resource.data.members.size() == 2;
      
      // Update: Jen členové, musí zůstat členy a počet členů musí zůstat 2 (bezpečnostní fix)
      allow update: if isMember() && willBeMember() && request.resource.data.members.size() == 2;
      
      // Mazání párů zakázáno
      allow delete: if false;
      
      // --------------------------------------------
      // MEMORIES (Subcollection)
      // --------------------------------------------
      match /memories/{memoryId} {
        // Kontrola existence páru a členství (vyžaduje extra read)
        function isCoupleMember() {
           return request.auth != null && 
                  exists(/databases/$(database)/documents/couples/$(coupleId)) &&
                  request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
        }
        function isAuthor() {
          return resource.data.authorId == request.auth.uid;
        }

        // Čtení a listování pro členy páru
        allow list, get: if isCoupleMember();
        
        // Vytvoření: Člen páru + autor jsem já + pairId sedí
        allow create: if isCoupleMember() && 
                         request.resource.data.authorId == request.auth.uid &&
                         request.resource.data.pairId == coupleId;
                         
        // Update: Kterýkoliv člen páru
        allow update: if isCoupleMember();
        
        // Smazat může jen autor
        allow delete: if isCoupleMember() && isAuthor();
      }
      
      // --------------------------------------------
      // INTIMACY LOGS (Subcollection)
      // --------------------------------------------
      match /intimacy_logs/{logId} {
        // Znovu funkce pro členství (scope je lokální)
        function isCoupleMember() {
           return request.auth != null && 
                  exists(/databases/$(database)/documents/couples/$(coupleId)) &&
                  request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
        }

        allow list, get: if isCoupleMember();
        
        // Vytvořit: Člen páru + initiatorId je jeden z členů
        allow create: if isCoupleMember() &&
                         request.resource.data.initiatorId in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
        
        // Update: Člen páru může upravit logy
        allow update: if isCoupleMember() &&
                         request.resource.data.initiatorId in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
        
        allow delete: if isCoupleMember();
      }
      
      // --------------------------------------------
      // NOTES (Subcollection)
      // --------------------------------------------
      match /notes/{noteId} {
        // Funkce pro členství v páru
        function isCoupleMember() {
           return request.auth != null && 
                  exists(/databases/$(database)/documents/couples/$(coupleId)) &&
                  request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
        }
        
        function isAuthor() {
          return resource.data.authorId == request.auth.uid;
        }

        // Čtení a listování pro členy páru
        allow list, get: if isCoupleMember();
        
        // Vytvoření: Člen páru + autor jsem já + správný typ
        allow create: if isCoupleMember() && 
                         request.resource.data.authorId == request.auth.uid &&
                         request.resource.data.type is string;
                         
        // Update: Kterýkoliv člen páru (může upravit i poznámky partnera)
        allow update: if isCoupleMember();
        
        // Smazat může jen autor
        allow delete: if isCoupleMember() && isAuthor();
      }
      
      // --------------------------------------------
      // EVENTS (Subcollection)
      // --------------------------------------------
      match /events/{eventId} {
        // Funkce pro členství v páru
        function isCoupleMember() {
           return request.auth != null && 
                  exists(/databases/$(database)/documents/couples/$(coupleId)) &&
                  request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
        }

        // Čtení a listování pro členy páru
        allow list, get: if isCoupleMember();
        
        // Vytvoření: Člen páru
        allow create: if isCoupleMember();
        
        // Update: Člen páru (může upravit eventy)
        allow update: if isCoupleMember();
        
        // Smazat může člen páru
        allow delete: if isCoupleMember();
      }
      
      // --------------------------------------------
      // CYCLE LOGS (Subcollection)
      // --------------------------------------------
      match /cycle_logs/{logId} {
        // Funkce pro členství v páru
        function isCoupleMember() {
           return request.auth != null && 
                  exists(/databases/$(database)/documents/couples/$(coupleId)) &&
                  request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
        }

        // Čtení a listování pro členy páru
        allow list, get: if isCoupleMember();
        
        // Vytvoření: Člen páru
        allow create: if isCoupleMember();
        
        // Update: Člen páru (může upravit logy)
        allow update: if isCoupleMember();
        
        // Smazat může člen páru
        allow delete: if isCoupleMember();
      }
      
      // --------------------------------------------
      // CYCLE SETTINGS (Subcollection)
      // --------------------------------------------
      match /cycle_settings/{settingsId} {
        // Funkce pro členství v páru
        function isCoupleMember() {
           return request.auth != null && 
                  exists(/databases/$(database)/documents/couples/$(coupleId)) &&
                  request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
        }

        // Čtení pro členy páru
        allow get: if isCoupleMember();
        
        // Listování pro členy páru
        allow list: if isCoupleMember();
        
        // Vytvoření: Člen páru
        allow create: if isCoupleMember();
        
        // Update: Člen páru (může upravit nastavení)
        allow update: if isCoupleMember();
        
        // Smazání zakázáno (settings by se neměly mazat)
        allow delete: if false;
      }
      
      // --------------------------------------------
      // HAPTIC SIGNALS (Subcollection)
      // --------------------------------------------
      match /haptic_signals/{signalId} {
        // Funkce pro členství v páru
        function isCoupleMember() {
           return request.auth != null && 
                  exists(/databases/$(database)/documents/couples/$(coupleId)) &&
                  request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
        }

        // Čtení pro členy páru
        allow get, list: if isCoupleMember();
        
        // Vytvoření: Člen páru, musí být odesílatel a fromUserId musí být v members
        allow create: if isCoupleMember() &&
                         request.resource.data.fromUserId == request.auth.uid &&
                         request.resource.data.fromUserId in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
        
        // Update: Člen páru (pro označení jako přečtené)
        allow update: if isCoupleMember();
        
        // Smazání: Člen páru
        allow delete: if isCoupleMember();
      }
      
      // --------------------------------------------
      // QUICK MESSAGES (Subcollection)
      // --------------------------------------------
      match /quick_messages/{messageId} {
        // Funkce pro členství v páru
        function isCoupleMember() {
           return request.auth != null && 
                  exists(/databases/$(database)/documents/couples/$(coupleId)) &&
                  request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
        }

        // Čtení pro členy páru
        allow get, list: if isCoupleMember();
        
        // Vytvoření: Člen páru, musí být odesílatel a fromUserId musí být v members
        allow create: if isCoupleMember() &&
                         request.resource.data.fromUserId == request.auth.uid &&
                         request.resource.data.fromUserId in get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
        
        // Update: Člen páru (pro označení jako přečtené)
        allow update: if isCoupleMember();
        
        // Smazání: Člen páru
        allow delete: if isCoupleMember();
      }
      
    }
    
    // ============================================
    // WAITLIST
    // ============================================
    match /waitlist/{emailId} {
      // Vytvořit: Kdokoliv, pokud email sedí s ID dokumentu
      allow create: if request.resource.data.email is string &&
                       request.resource.data.email == emailId;
      
      // Kontrola existence (get), ale zákaz hromadného výpisu (list)
      allow get: if true;
      allow list, update, delete: if false;
    }
    
    // ============================================
    // DEFAULT DENY
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}